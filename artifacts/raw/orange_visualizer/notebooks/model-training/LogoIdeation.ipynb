   "source": [
    "### Egg Generation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 105,
   "metadata": {},
   "outputs": [],
   "source": [
    "# List of different dinosaur types for prompt tweaks\n",
    "egg_states = [\n",
    "    \"Broken\", \"Cracking\", \"Slightly Cracked\", \"Hatching\", \"Hatched\", \"Open\",\n",
    "]\n",
    "\n",
    "egg_list = []\n",
    "\n",
    "# Loop through the dinosaur list, modifying the prompt slightly for each type\n",
    "for state in egg_states:\n",
    "    # Define the prompt with the current dinosaur type\n",
    "    prompt = f\"Simplistic and cartoonish image of a {state} dinosaur egg. Fully white background. Minimalistic and cute.\"\n",
    "    \n",
    "    # Call OpenAI API to generate the image\n",
    "    response = client.images.generate(\n",
    "        model=\"dall-e-3\",\n",
    "        prompt=prompt,\n",
    "        size=\"1024x1024\",\n",
    "        quality=\"standard\",\n",
    "        n=1,\n",
    "    )\n",
    "\n",
    "    # Extract the URL of the generated image\n",
    "    image_url = response.data[0].url\n",
    "    \n",
    "    # Fetch the image from the URL\n",
    "    img_response = requests.get(image_url)\n",
    "    img = Image.open(BytesIO(img_response.content))\n",
    "    \n",
    "    # Append the image to the list\n",
    "    egg_list.append(img)"
   ]
  },
