    "# Display all images at the end\n",
    "fig, axes = plt.subplots(1, len(egg_states), figsize=(20, 5))\n",
    "\n",
    "for i, img in enumerate(egg_list):\n",
    "    axes[i].imshow(img)\n",
    "    axes[i].axis('off')  # Hide axes\n",
    "\n",
    "plt.show()"
